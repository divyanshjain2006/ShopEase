# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shoppease?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-string

# Stripe TEST MODE keys from https://dashboard.stripe.com/apikeys
# Use Publishable + Secret (test mode) keys only. Never use live keys here.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx

# Optional: Stripe webhook secret if you want payment completion handling
# Get it from Stripe CLI: stripe listen --forward-to localhost:5000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
BASE_URL=http://localhost:5173
